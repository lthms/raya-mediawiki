{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "hostname"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$|^[a-z]$",
      "maxLength": 30
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hostname": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*\\.[a-z0-9]+$",
      "maxLength": 253
    },
    "appSecret": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^$|^[a-z][a-z0-9_]{0,62}$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*Gi$"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "suspend": {
          "type": "boolean"
        },
        "keepDaily": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
